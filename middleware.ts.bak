import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';

export function middleware(request: NextRequest) {
  // 1. Proteger todas las rutas que empiecen con /admin
  if (request.nextUrl.pathname.startsWith('/admin')) {
    
    // 2. Buscar cookies de sesión de Supabase (usualmente empiezan con 'sb-')
    // Esto verifica si el usuario ya se logueó anteriormente.
    const allCookies = request.cookies.getAll();
    const hasSupabaseSession = allCookies.some(cookie => cookie.name.startsWith('sb-'));

    // 3. Si NO tiene sesión, lo mandamos al login
    if (!hasSupabaseSession) {
      // Asumiendo que tu página de login está en /login o /admin/login
      // Ajusta la URL si tu login está en otra ruta
      return NextResponse.redirect(new URL('/login', request.url));
    }
  }

  // 4. Si todo está bien, lo dejamos pasar
  return NextResponse.next();
}

// Configurar para que solo se ejecute en rutas de admin
export const config = {
  matcher: ['/admin/:path*'],
};